# homeassistant-xiaozhiserver 环境变量模板
# 用法：cp .env.example .env，并填写必填项；其余变量均有代码默认值，需要覆盖时取消注释。
# 读取位置：homeassistant_xiaozhiserver/settings.py（config.py 仅兼容导出）；
# PUID/PGID 仅由 docker-compose.yml 的 user 插值读取，不会被应用代码读取。

# ===== 必填（无默认值，必须设置） =====
MCP_ENDPOINT=ws://<宿主>:8004/mcp_endpoint/mcp/?token=<TOKEN>
HA_URL=https://your-ha.example:8123
HA_TOKEN=请替换为你的 HA 长期访问令牌

# ===== WebUI 登录令牌（强烈建议固定；留空会启动时随机生成并打印到日志）=====
# 打开 WebUI 时输入该值；重启后若未固定，旧会话会失效。
WEBUI_TOKEN=

# ===== 可选：HA 请求（默认值） =====
# HA_TIMEOUT=10
# HA_VERIFY_SSL=true
# HA_TRUST_ENV=false
# HA_WS_ENABLED=true
# HA_WS_URL 留空自动由 HA_URL 推导为 ws(s)://<host>/api/websocket
# HA_WS_URL=
# HA_REGISTRY_TTL=60
# HA_REGISTRY_ERROR_TTL=10

# ===== 可选：状态事件与缓存（默认值） =====
# HA_STATE_WS_ENABLED=true
# HA_STATE_CACHE_TTL=1.0
# HA_SERVICES_CACHE_TTL=300
# HA_STATE_WS_MAX_FAILURES=5

# ===== 可选：服务调用回读确认（默认值） =====
# SERVICE_CONFIRM_DELAY=0.15
# SERVICE_CONFIRM_RETRIES=3
# SERVICE_CONFIRM_INTERVAL=0.15
# SERVICE_CONFIRM_TIMEOUT=4.0

# ===== 可选：危险操作二次确认（默认值） =====
# DANGER_CONFIRM_ENABLED=true
# DANGER_CONFIRM_TTL=120
# DANGEROUS_DOMAINS=lock,alarm_control_panel
# DANGEROUS_COVER_CLASSES=garage,door,gate,window
# DANGEROUS_SERVICE_DOMAINS=lock,alarm_control_panel,script,shell_command,python_script

# ===== 可选：设备范围（默认值） =====
# EXCLUDED_DOMAINS=automation,media_player
# EXCLUDED_DEVICE_KEYWORDS=门铃,水壶,中枢网关

# ===== 可选：日志（默认值） =====
# LOG_LEVEL=INFO
# LOG_FILE 空：非容器使用临时目录；compose 默认 /app/logs/homeassistant-xiaozhiserver.log
# LOG_FILE=
# LOG_FILE_WEBUI 留空自动由 LOG_FILE 推导 .webui.log
# LOG_FILE_WEBUI=
# LOG_FILE_BRIDGE 留空自动由 LOG_FILE 推导 .bridge.log
# LOG_FILE_BRIDGE=
# LOG_FILE_MCP 留空自动由 LOG_FILE 推导 .mcp.log（stdio MCP server 子进程）
# LOG_FILE_MCP=
# LOG_FORMAT=text（text 或 json）
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=3

# ===== 可选：分页与并发（默认值） =====
# DEFAULT_LIST_LIMIT=50
# MAX_LIST_LIMIT=500
# CONTROL_CONCURRENCY 批量控制并发上限
# CONTROL_CONCURRENCY=5
# CONTROL_BATCH_TIMEOUT 批量控制总时限（秒），超时条目返回 pending_confirmation
# CONTROL_BATCH_TIMEOUT=8.0

# ===== 可选：WebUI（默认值） =====
# WEBUI_HOST=0.0.0.0
# WEBUI_PORT=8099
# WEBUI_ALLOWED_HOSTS=
# WEBUI_CACHE_TTL WebUI 状态/设备接口缓存秒数
# WEBUI_CACHE_TTL=3.0
# METRICS_ENABLED 是否暴露 /metrics
# METRICS_ENABLED=true

# ===== 可选：容器时区（默认 Asia/Shanghai） =====
# TZ=Asia/Shanghai

# ===== 可选：容器用户（仅 compose 使用，应用不读取） =====
# PUID=1000
# PGID=1000
