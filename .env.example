# ===== 小智 MCP 接入点（工具端 WebSocket）=====
# 从智控台「MCP 接入点」参数中获取工具端地址；不是 /mcp_endpoint/health?key=... 那个地址。
MCP_ENDPOINT=ws://<宿主>:8004/mcp_endpoint/mcp/?token=<TOKEN>

# ===== Home Assistant 连接 =====
HA_URL=https://your-ha.example:8123
HA_TOKEN=请替换为你的HA长期访问令牌

# ===== HA 请求 =====
HA_TIMEOUT=10
HA_VERIFY_SSL=true
HA_TRUST_ENV=false

# ===== 设备/实体注册表（按设备聚合，HA 仅 WebSocket API 提供） =====
HA_WS_ENABLED=true
# 留空则由 HA_URL 自动推导为 ws(s)://<host>/api/websocket
HA_WS_URL=
HA_REGISTRY_TTL=60
# 注册表读取失败后的重试间隔（秒），避免瞬时 WS 故障后长时间不重试
HA_REGISTRY_ERROR_TTL=10
# 服务调用后回读确认（状态+属性四态校验：confirmed/no_change/mismatch/accepted_pending）
SERVICE_CONFIRM_DELAY=0.6
SERVICE_CONFIRM_RETRIES=1
SERVICE_CONFIRM_INTERVAL=0.6
SERVICE_CONFIRM_TIMEOUT=4.0

# ===== 危险设备二次确认（防误操作） =====
# 门锁/安防面板/车库门/门窗类 cover 需二次确认；首次返回 confirmation_required + confirm_token
DANGER_CONFIRM_ENABLED=true
DANGER_CONFIRM_TTL=120
DANGEROUS_DOMAINS=lock,alarm_control_panel
DANGEROUS_COVER_CLASSES=garage,door,gate,window
# 即使目标实体普通，这些服务域也强制二次确认（脚本/系统命令等）
DANGEROUS_SERVICE_DOMAINS=lock,alarm_control_panel,script,shell_command,python_script

# ===== 设备范围（默认隐藏五类设备）=====
# 按 domain 隐藏：自动化、媒体
EXCLUDED_DOMAINS=automation,media_player
# 按名称关键字隐藏：门铃、热水壶、中枢网关（匹配实体名/entity_id/设备注册表名称）
EXCLUDED_DEVICE_KEYWORDS=门铃,水壶,中枢网关

# ===== 其他 =====
LOG_LEVEL=INFO
# 共享日志文件；留空则用系统临时目录下的 homeassistant-xiaozhiserver.log
# WebUI 的“服务日志”读取该文件，bridge 也写入同一文件；容器内建议挂载到卷
LOG_FILE=
# 单文件轮转阈值（字节）与保留份数；LOG_MAX_BYTES=0 表示不按大小轮转
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
DEFAULT_LIST_LIMIT=50
MAX_LIST_LIMIT=500

# ===== WebUI =====
# 随服务一起启动，固定监听 0.0.0.0:8099，无独立密码；
# 直接使用上面的 HA_URL / HA_TOKEN 连接 Home Assistant，无需额外环境变量。
# 仅绑定可信内网，不要直接暴露公网。
# 额外允许访问 WebUI 的 Host（逗号分隔，不含端口）；默认已允许 localhost 与内网 IP
WEBUI_ALLOWED_HOSTS=
